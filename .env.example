# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Optional. Leave unset to use Microsoft Entra ID (az login).
AZURE_SEARCH_API_KEY=

# Foundry resource (hosts the embedding and chat model deployments)
FOUNDRY_RESOURCE_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
# Optional. Leave unset to use Microsoft Entra ID for embeddings, and the search
# service's managed identity for query planning and query-time vectorisation.
FOUNDRY_API_KEY=

FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Must be a GPT-5 family model. Filter query hints return HTTP 400 with GPT-4o / GPT-4.1.
FOUNDRY_LLM_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_LLM_MODEL=gpt-5.4-mini
